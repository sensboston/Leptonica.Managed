<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Leptonica</RootNamespace>
    <AssemblyName>Leptonica.Managed</AssemblyName>
    <DefineConstants>$(DefineConstants);NETSTANDARD;FIX_JPEG_IS_OJPEG</DefineConstants>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Leptonica.Managed</PackageId>
    <Version>1.0.0</Version>
    <Description>A fully managed C# implementation of Leptonica 1.87.0, the image processing and image analysis library by Dan Bloomberg. No P/Invoke and no native binaries: the results match the C library, and the PNG, JPEG, TIFF, GIF, WebP, JPEG 2000, BMP and PNM codecs are included. SIMD, multithreading and optional GPU acceleration.</Description>
    <PackageTags>leptonica;image-processing;image-analysis;document-image;ocr;morphology;binarization;deskew;tiff;png;jpeg</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/sensboston/Leptonica.Managed/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ILGPU" />
    <PackageReference Include="ILGPU.Algorithms" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Leptonica.Managed.Tests" />
    <InternalsVisibleTo Include="ILGPURuntime" />
    <InternalsVisibleTo Include="bench_managed" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Morph\Templates\*.txt" LogicalName="Leptonica.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\README.md" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
