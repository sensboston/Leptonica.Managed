<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Explorer.MainWindow"
        Title="Leptonica.Managed Explorer"
        Width="1400" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- Status bar: time of the last run, where it ran, GPU switch -->
    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <CheckBox x:Name="UseGpu" DockPanel.Dock="Right" Content="Use the GPU" IsChecked="True" />
        <TextBlock x:Name="Status" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Operations by category -->
    <Border DockPanel.Dock="Left" Width="240" BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TreeView x:Name="Operations" Margin="4" />
    </Border>

    <!-- Description and parameters of the selected operation -->
    <Border DockPanel.Dock="Right" Width="300" BorderThickness="1,0,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">
          <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="Description" TextWrapping="Wrap" Opacity="0.8" />
          <StackPanel x:Name="Parameters" Spacing="10" />
          <TextBlock x:Name="NoteText" TextWrapping="Wrap" FontWeight="SemiBold" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Image source and the two views -->
    <DockPanel Margin="12">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
        <TextBlock Text="Image" VerticalAlignment="Center" />
        <ComboBox x:Name="Images" MinWidth="200" />
        <Button x:Name="OpenButton" Content="Open..." />
        <Button x:Name="SaveButton" Content="Save result..." />
        <TextBlock x:Name="ImageInfo" VerticalAlignment="Center" Opacity="0.7" Margin="8,0,0,0" />
      </StackPanel>
      <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="Original" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Column="2" Text="Result" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Border Grid.Row="1" Grid.Column="0" Background="#20808080" CornerRadius="4">
          <Image x:Name="Original" Stretch="Uniform" Margin="4" />
        </Border>
        <Border Grid.Row="1" Grid.Column="2" Background="#20808080" CornerRadius="4">
          <Grid>
            <Image x:Name="Result" Stretch="Uniform" Margin="4" />
            <TextBlock x:Name="Busy" Text="working..." IsVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </DockPanel>

  </DockPanel>
</Window>
