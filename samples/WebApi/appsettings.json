{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://localhost:5080",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 52428800
    }
  },
  "Preprocess": {
    "NormalizeBackground": true,
    "Deskew": true,
    "Threshold": 130,
    "MinComponentSize": 3,
    "MaxImageBytes": 52428800
  }
}
